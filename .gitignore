node_modules/
dist/
.DS_Store
*.local
.vite/

# playwright mcp scratch output
.playwright-mcp/

# art proofing output
tools/art/preview.png

# raw AI art is large and regenerable; processed sprites are committed
assets/raw/

# --- Unity (ScrapTitan) ---
# Everything Unity regenerates from Assets/, Packages/ and ProjectSettings/.
ScrapTitan/[Ll]ibrary/
ScrapTitan/[Tt]emp/
ScrapTitan/[Oo]bj/
ScrapTitan/[Bb]uilds/
Builds/
*_BurstDebugInformation_DoNotShip/
*.provenance.json
ScrapTitan/[Ll]ogs/
ScrapTitan/[Uu]ser[Ss]ettings/
ScrapTitan/[Mm]emoryCaptures/
ScrapTitan/[Rr]ecordings/
# Scratch space for the Android IL2CPP and Gradle build.
ScrapTitan/.utmp/
ScrapTitan/.gradle/
ScrapTitan/.consulo/
ScrapTitan/.idea/
ScrapTitan/.vsconfig
ScrapTitan/*.csproj
ScrapTitan/*.sln
ScrapTitan/*.unityproxy

# Crash handler output and Unity's own leftovers
sysinfo.txt
*.stackdump

# Build and test output
Logs/
test-results.xml
ScrapTitan/test-results.xml

# Signing keys and their passwords never enter the repo.
*.keystore
*.jks
keystore.env

# Model deliveries land here for checking. They are large binaries and are not the
# source of truth; what gets committed is the prepared asset inside ScrapTitan/Assets.
unity_assets/INCOMING/

# Generated model sources. tools/modelgen is what is kept; the .fbx and .png the Unity
# project imports live under ScrapTitan/Assets/_Game/Art/Generated and are committed.
unity_assets/GENERATED/

# Blender writes these next to the generator scripts.
__pycache__/
*.pyc
