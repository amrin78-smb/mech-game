              "description": "Depth of one ground tile, from brief 28."
            },
            "tileCount": {
              "type": "integer",
              "minimum": 2,
              "description": "Tiles per lane in the scrolling ring. tileLength times this must span spawnX to despawnX."
            }
          }
        },
