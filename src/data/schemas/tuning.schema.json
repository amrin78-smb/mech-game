                  "exclusiveMinimum": 0,
                  "description": "Along the lane, which is the screen horizontal."
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Across the lane, which is the screen depth."
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Standing height."
                }
              }
            }
          },
          "description": "Size per armour class, used for the placeholder shape and the hit radius. The light class comes from the Rustcrawler's brief, which makes it 3.2 m long; the others keep the size they had relative to light in the Phaser build. The briefs and the Phaser art disagree by about 25% on how big an enemy is next to the Titan, and the briefs are the approved source."
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pitchDegrees",
            "orthographicSize",
            "distance",
            "targetX",
            "targetY"
          ],
          "properties": {
            "pitchDegrees": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Degrees below horizontal. Every model brief authors its art for this angle, so it is not a free parameter."
            },
            "orthographicSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Half the visible height. Orthographic, not perspective: the plan puts everything at one camera distance so the models need no detail levels, and it keeps a far lane the same size as a near one."
            },
            "distance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "How far back the camera sits. Orthographic, so this sets clipping, not framing."
            },
            "targetX": {
              "type": "number",
              "description": "World X the camera centres on."
            },
            "targetY": {
              "type": "number",
              "description": "World Y the camera centres on."
            }
          }
        },
