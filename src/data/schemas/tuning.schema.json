        },
        "dragThresholdScreenFraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How far a pointer must travel to become a manual aim, as a fraction of screen height rather than pixels, so it means the same on a 720p and a 1440p phone."
        },
        "touchAimOffsetScreenFraction": {
          "type": "number",
