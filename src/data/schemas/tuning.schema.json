{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tuning.schema.json",
  "title": "Tuning",
  "description": "Global tuning constants that are not per entity. Hard rule 4: gameplay code reads its numbers from here.",
  "type": "object",
  "required": [
    "damageMatrix",
    "mecha",
    "world",
    "inBattleUpgrades",
    "vfx",
    "pools",
    "targeting",
    "boss",
    "audio",
    "combat",
    "meta",
    "tutorial",
    "endless",
    "world3d"
  ],
  "additionalProperties": false,
  "definitions": {
    "armorMultipliers": {
      "type": "object",
      "required": [
        "light",
        "armored",
        "shielded",
        "swarm"
      ],
      "additionalProperties": false,
      "properties": {
        "light": {
          "type": "number",
          "minimum": 0
        },
        "armored": {
          "type": "number",
          "minimum": 0
        },
        "shielded": {
          "type": "number",
          "minimum": 0
        },
        "swarm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "upgradeTrack": {
      "type": "object",
      "required": [
        "baseCost",
        "costGrowth"
      ],
      "additionalProperties": false,
      "properties": {
        "baseCost": {
          "type": "number",
          "minimum": 0
        },
        "costGrowth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bonusPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "healFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "properties": {
    "damageMatrix": {
      "type": "object",
      "description": "damage type to armor class multipliers, applied only inside DamageSystem",
      "required": [
        "kinetic",
        "chemical",
        "piercing",
        "explosive"
      ],
      "additionalProperties": false,
      "properties": {
        "kinetic": {
          "$ref": "#/definitions/armorMultipliers"
        },
        "chemical": {
          "$ref": "#/definitions/armorMultipliers"
        },
        "piercing": {
          "$ref": "#/definitions/armorMultipliers"
        },
        "explosive": {
          "$ref": "#/definitions/armorMultipliers"
        }
      }
    },
    "mecha": {
      "type": "object",
      "required": [
        "baseHullHp",
        "lanesY",
        "turretMountCount"
      ],
      "additionalProperties": false,
      "properties": {
        "baseHullHp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lanesY": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "lane centres as a fraction of screen height"
        },
        "turretMountCount": {
          "type": "integer",
          "minimum": 0
        },
        "bobAmplitude": {
          "type": "number",
          "minimum": 0,
          "description": "idle torso bob, px"
        },
        "bobPeriod": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds per bob cycle"
        },
        "swayAmplitude": {
          "type": "number",
          "minimum": 0,
          "description": "idle torso sway, degrees"
        },
        "swayPeriod": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds per sway cycle"
        },
        "turretMountOffsets": {
          "type": "array",
          "description": "turret mount positions relative to the torso, [x, y] pairs; mount 0 is the Phase 2 mount",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "walkPeriod": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds for a full two step stride"
        },
        "walkBob": {
          "type": "number",
          "minimum": 0,
          "description": "px the hull rises and falls per step"
        },
        "walkPitch": {
          "type": "number",
          "minimum": 0,
          "description": "degrees the hull rocks fore and aft while walking"
        },
        "legArticulation": {
          "type": "object",
          "description": "Splits the legs sprite into a hip block and two legs so the walk cycle can swing them",
          "required": [
            "hipFraction",
            "gapFraction",
            "overlapFraction",
            "swingDegrees",
            "liftPixels"
          ],
          "additionalProperties": false,
          "properties": {
            "hipFraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "height fraction where the hip block ends and the legs begin"
            },
            "gapFraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "width fraction of the gap between the two legs"
            },
            "overlapFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "height fraction the legs tuck up under the hips, so lifting one cannot open a seam"
            },
            "swingDegrees": {
              "type": "number",
              "minimum": 0,
              "description": "how far each leg rotates about its hip"
            },
            "liftPixels": {
              "type": "number",
              "minimum": 0,
              "description": "on screen px the swinging leg lifts"
            }
          }
        },
        "legsFaceLeft": {
          "type": "boolean",
          "description": "the generated legs art faces left, so it is flipped to match the torso"
        }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "baseWidth",
        "baseHeight",
        "mechaXFraction",
        "spawnXFraction",
        "despawnXFraction",
        "meleeStandoff",
        "projectileRadius",
        "projectileLifetime",
        "parallax",
        "maxFrameSeconds",
        "burrowSpawnXFraction",
        "flyingYOffset"
      ],
      "additionalProperties": false,
      "properties": {
        "enemyBaseSize": {
          "type": "object",
          "description": "Placeholder sprite size per armor class before the enemy's own scale; read by the art generator and by the sim's spread model",
          "required": [
            "light",
            "armored",
            "shielded",
            "swarm"
          ],
          "additionalProperties": false,
          "properties": {
            "light": {
              "$ref": "#/$defs/size"
            },
            "armored": {
              "$ref": "#/$defs/size"
            },
            "shielded": {
              "$ref": "#/$defs/size"
            },
            "swarm": {
              "$ref": "#/$defs/size"
            }
          }
        },
        "hitscanRangeFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How far a hitscan beam carries, as a multiple of baseWidth; read by the weapon systems and by the sim"
        },
        "baseWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "baseHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mechaXFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spawnXFraction": {
          "type": "number",
          "description": "enemy spawn x as a fraction of width, above 1 is off screen right"
        },
        "despawnXFraction": {
          "type": "number",
          "description": "x fraction past which a projectile is recycled"
        },
        "meleeStandoff": {
          "type": "number",
          "minimum": 0,
          "description": "px from the mecha centre where melee enemies stop and attack"
        },
        "projectileRadius": {
          "type": "number",
          "minimum": 0,
          "description": "collision radius of a shell, added to the target radius"
        },
        "projectileLifetime": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds before an unspent shell is recycled"
        },
        "parallax": {
          "type": "object",
          "required": [
            "sky",
            "ruins",
            "ground"
          ],
          "additionalProperties": false,
          "description": "scroll speed factors applied to the level scrollSpeed",
          "properties": {
            "sky": {
              "type": "number",
              "minimum": 0
            },
            "ruins": {
              "type": "number",
              "minimum": 0
            },
            "ground": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "maxFrameSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "largest delta a single frame may apply, so a backgrounded tab does not teleport the wave"
        },
        "burrowSpawnXFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "where burrow behaviour enemies erupt, as a fraction of width"
        },
        "flyingYOffset": {
          "type": "number",
          "minimum": 0,
          "description": "px a flying enemy sits above its lane"
        }
      }
    },
    "inBattleUpgrades": {
      "type": "object",
      "required": [
        "damage",
        "fireRate",
        "repair"
      ],
      "additionalProperties": false,
      "properties": {
        "damage": {
          "$ref": "#/definitions/upgradeTrack"
        },
        "fireRate": {
          "$ref": "#/definitions/upgradeTrack"
        },
        "repair": {
          "$ref": "#/definitions/upgradeTrack"
        }
      }
    },
    "vfx": {
      "type": "object",
      "required": [
        "maxParticlesDesktop",
        "maxParticlesMobile",
        "shakeMaxIntensity",
        "damageNumberPoolSize"
      ],
      "additionalProperties": false,
      "properties": {
        "maxParticlesDesktop": {
          "type": "integer",
          "minimum": 0
        },
        "maxParticlesMobile": {
          "type": "integer",
          "minimum": 0
        },
        "shakeMaxIntensity": {
          "type": "number",
          "minimum": 0
        },
        "damageNumberPoolSize": {
          "type": "integer",
          "minimum": 0
        },
        "scrapPickupRiseSpeed": {
          "type": "number",
          "minimum": 0
        },
        "scrapPickupLifetime": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hitFlashDuration": {
          "type": "number",
          "minimum": 0,
          "description": "seconds a damaged enemy stays tinted"
        },
        "hitFlashCooldown": {
          "type": "number",
          "minimum": 0,
          "description": "seconds after a flash before another can start, so a target under sustained fire keeps its silhouette"
        },
        "hitFlashTint": {
          "type": "integer",
          "minimum": 0,
          "description": "tint colour applied on hit"
        },
        "damageNumberRise": {
          "type": "number",
          "minimum": 0,
          "description": "px a damage number floats upward per second"
        },
        "damageNumberLifetime": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "muzzleFlashDuration": {
          "type": "number",
          "minimum": 0
        },
        "shakePerDamage": {
          "type": "number",
          "minimum": 0,
          "description": "camera shake intensity per point of damage taken, clamped by shakeMaxIntensity"
        },
        "shakeDurationMs": {
          "type": "number",
          "minimum": 0
        },
        "impactParticleCount": {
          "type": "integer",
          "minimum": 0
        },
        "deathParticleCount": {
          "type": "integer",
          "minimum": 0
        },
        "exhaustSmokeFrequency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "ms between exhaust smoke puffs"
        },
        "cannonRecoilPixels": {
          "type": "number",
          "minimum": 0,
          "description": "px the main cannon kicks back on firing"
        },
        "turretRecoilPixels": {
          "type": "number",
          "minimum": 0
        },
        "recoilRecovery": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "how fast recoil decays back to rest, per second"
        },
        "muzzleFlashPoolSize": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pools": {
      "type": "object",
      "required": [
        "projectiles",
        "enemies"
      ],
      "additionalProperties": false,
      "properties": {
        "projectiles": {
          "type": "integer",
          "minimum": 1
        },
        "enemies": {
          "type": "integer",
          "minimum": 1
        },
        "scrapPickups": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "targeting": {
      "type": "object",
      "required": [
        "priorityOrder",
        "manualShotDamageMultiplier",
        "autoFireResumeDelay"
      ],
      "additionalProperties": false,
      "properties": {
        "priorityOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "focus",
              "ranged_in_range",
              "closest"
            ]
          }
        },
        "manualShotDamageMultiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "autoFireResumeDelay": {
          "type": "number",
          "minimum": 0,
          "description": "seconds of auto fire pause after a manual shot"
        },
        "manualDragThreshold": {
          "type": "number",
          "minimum": 0,
          "description": "px of pointer travel that turns a tap into a manual aim drag"
        },
        "touchDragOriginMinYFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "touch drags must start below this fraction of screen height so fingers do not cover the action"
        },
        "touchAimOffsetY": {
          "type": "number",
          "minimum": 0,
          "description": "px the touch aim point sits above the finger so it never covers the target"
        }
      }
    },
    "boss": {
      "type": "object",
      "description": "shared boss phase behaviour; per boss stats stay in enemies.json",
      "required": [
        "default",
        "byId"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "required": [
            "phase2HpFraction",
            "chargeSpeedMultiplier",
            "chargeDuration",
            "chargeCooldown"
          ],
          "additionalProperties": false,
          "properties": {
            "phase2HpFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "chargeSpeedMultiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "chargeDuration": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "chargeCooldown": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "entranceShakeIntensity": {
              "type": "number",
              "minimum": 0
            },
            "slamShakeIntensity": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "byId": {
          "type": "object",
          "description": "keyed by the boss enemy id in enemies.json",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "charger",
                  "shield_cycler",
                  "enrager"
                ]
              },
              "shieldUpDuration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ventDuration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "enrageThresholds": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "enrageSpeedBonus": {
                "type": "number",
                "minimum": 0
              },
              "enrageDamageBonus": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "masterVolume",
        "sfxVolume",
        "musicVolume"
      ],
      "additionalProperties": false,
      "properties": {
        "masterVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sfxVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "musicVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "combat": {
      "type": "object",
      "required": [
        "shieldNonPiercingFactor"
      ],
      "additionalProperties": false,
      "properties": {
        "shieldNonPiercingFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "GAME_DESIGN section 6: only piercing damages a shield pool at full value"
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Hangar economy. Weapon and pilot stat tracks stay in weapons.json and pilots.json.",
      "required": [
        "startingWeapons",
        "weaponUnlockCosts",
        "turretMountCosts",
        "hullUpgrade"
      ],
      "additionalProperties": false,
      "properties": {
        "startingWeapons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "owned on a fresh save"
        },
        "zoneNames": {
          "type": "object",
          "description": "Zone number to the heading shown on the map; authoring a zone 4 adds a key here and nothing else",
          "additionalProperties": {
            "type": "string"
          }
        },
        "weaponUnlockCosts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "cores to unlock, keyed by weapon id"
        },
        "turretMountCosts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "cores for mounts 2 and 3; mount 1 is free"
        },
        "hullUpgrade": {
          "type": "object",
          "required": [
            "costs",
            "bonusPerLevel"
          ],
          "additionalProperties": false,
          "properties": {
            "costs": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "bonusPerLevel": {
              "type": "number",
              "minimum": 0,
              "description": "additive hull fraction per level"
            }
          }
        }
      }
    },
    "tutorial": {
      "type": "object",
      "description": "Phase 4 tutorial hints. Shown only on the named level.",
      "required": [
        "levelId",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "levelId": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "duration",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0,
                "description": "seconds from battle start"
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "endless": {
      "type": "object",
      "description": "Endless mode, GAME_DESIGN section 12: a generated timeline fed to the same WaveSpawner.",
      "required": [
        "firstWaveAt",
        "waveInterval",
        "waveCount",
        "hpGrowth",
        "countGrowth",
        "tiers",
        "elites"
      ],
      "additionalProperties": false,
      "properties": {
        "firstWaveAt": {
          "type": "number",
          "minimum": 0
        },
        "waveInterval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "waveCount": {
          "type": "integer",
          "minimum": 1,
          "description": "long enough that nobody reaches the end"
        },
        "hpGrowth": {
          "type": "number",
          "minimum": 0,
          "description": "added hp multiplier per wave"
        },
        "countGrowth": {
          "type": "number",
          "minimum": 0
        },
        "maxCount": {
          "type": "integer",
          "minimum": 1
        },
        "eliteEvery": {
          "type": "integer",
          "minimum": 1,
          "description": "a boss statted enemy arrives this often"
        },
        "coresPerNewWave": {
          "type": "integer",
          "minimum": 0,
          "description": "cores per wave beyond your previous best"
        },
        "unlockAfterLevel": {
          "type": "string"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "fromWave",
              "enemies"
            ],
            "additionalProperties": false,
            "properties": {
              "fromWave": {
                "type": "integer",
                "minimum": 1
              },
              "enemies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "elites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "world3d": {
      "type": "object",
      "description": "The same world as `world`, in metres, for the Unity build. `world` is still in the 1280x720 screen pixels the Phaser build used; every length and speed here is that number divided by pixelsPerMetre. The scale is uniform, which is what protects the balance: a clear time depends on distance over speed, and both divide by the same number, so the clear times the Phaser sim reports carry across unchanged.",
      "additionalProperties": false,
      "required": [
        "pixelsPerMetre",
        "viewWidthMetres",
        "viewHeightMetres",
        "titanX",
        "spawnX",
        "despawnX",
        "engageMaxX",
        "burrowSpawnX",
        "meleeStandoff",
        "projectileRadius",
        "flyingHeight",
        "laneZ",
        "laneGroundY",
        "enemyBaseSize",
        "camera",
        "ground",
        "recoil",
        "scrapPickupRise",
        "damageNumberRise",
        "dragThresholdScreenFraction",
        "touchAimOffsetScreenFraction"
      ],
      "properties": {
        "pixelsPerMetre": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Screen pixels per metre in the Phaser build, which is how every number here was derived. The Phaser Titan stood 266 px tall and its brief makes it 14.2 m to the torso roof, which is 18.7 px per metre; 20 is that rounded, which puts the briefed Titan at 284 px against Phaser's 266 and makes the visible world a round 64 by 36 metres."
        },
        "viewWidthMetres": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Visible width at 16:9. Phone screens in landscape are all wider than 16:9, so they show more than this and never less, which keeps the spawn line off screen."
        },
        "viewHeightMetres": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Visible height. The camera's orthographicSize is half of it."
        },
        "titanX": {
          "type": "number",
          "description": "The Titan stands at the world origin, so every other X reads as a distance from it."
        },
        "spawnX": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Where enemies enter, off the right edge."
        },
        "despawnX": {
          "type": "number",
          "description": "Past the left edge, where anything that got through is recycled."
        },
        "engageMaxX": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The engagement line. Targeting ignores anything beyond it so the cannon cannot snipe an enemy before the player can see it."
        },
        "burrowSpawnX": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Where the `burrow` behaviour erupts, mid field instead of at the spawn line."
        },
        "meleeStandoff": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Gap a melee enemy stops at, measured from titanX before its own half length."
        },
        "projectileRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Hit radius of a shell."
        },
        "flyingHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How far above its lane a flyer rides."
        },
        "laneZ": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          },
          "description": "Lane centres in depth. Lane 0 is the farthest from the camera, matching the Phaser build where lane 0 sat highest on screen. The spacing is the ground tile's own depth: a tile is 12 m deep, so lanes closer together than that overlap, and a higher terrace then buries the lane in front of it, legs and all."
        },
        "laneGroundY": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          },
          "description": "Ground height per lane, one entry per laneZ. At the briefed 12 degree camera, 12 m of depth separates two lanes by 2.5 m on screen; a 1.1 m terrace step adds another 1.1, for about 3.6 m in all, which clears a 1.4 m Rustcrawler comfortably. The owner judges this from the running game."
        },
        "enemyBaseSize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "light",
            "armored",
            "shielded",
            "swarm"
          ],
          "properties": {
            "light": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "length",
                "width",
                "height"
              ],
              "properties": {
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Along the lane, which is the screen horizontal."
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Across the lane, which is the screen depth."
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Standing height."
                }
              }
            },
            "armored": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "length",
                "width",
