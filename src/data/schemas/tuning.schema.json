{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tuning.schema.json",
  "title": "Tuning",
  "description": "Global tuning constants that are not per entity. Hard rule 4: gameplay code reads its numbers from here.",
  "type": "object",
  "required": [
    "damageMatrix",
    "mecha",
    "world",
    "inBattleUpgrades",
    "vfx",
    "pools",
    "targeting",
    "boss",
    "audio",
    "combat",
    "meta",
    "tutorial"
  ],
  "additionalProperties": false,
  "definitions": {
    "armorMultipliers": {
      "type": "object",
      "required": [
        "light",
        "armored",
        "shielded",
        "swarm"
      ],
      "additionalProperties": false,
      "properties": {
        "light": {
          "type": "number",
          "minimum": 0
        },
        "armored": {
          "type": "number",
          "minimum": 0
        },
        "shielded": {
          "type": "number",
          "minimum": 0
        },
        "swarm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "upgradeTrack": {
      "type": "object",
      "required": [
        "baseCost",
        "costGrowth"
      ],
      "additionalProperties": false,
      "properties": {
        "baseCost": {
          "type": "number",
          "minimum": 0
        },
        "costGrowth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bonusPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "healFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "properties": {
    "damageMatrix": {
      "type": "object",
      "description": "damage type to armor class multipliers, applied only inside DamageSystem",
      "required": [
        "kinetic",
        "chemical",
        "piercing",
        "explosive"
      ],
      "additionalProperties": false,
      "properties": {
        "kinetic": {
          "$ref": "#/definitions/armorMultipliers"
        },
        "chemical": {
          "$ref": "#/definitions/armorMultipliers"
        },
        "piercing": {
          "$ref": "#/definitions/armorMultipliers"
        },
        "explosive": {
          "$ref": "#/definitions/armorMultipliers"
        }
      }
    },
    "mecha": {
      "type": "object",
      "required": [
        "baseHullHp",
        "lanesY",
        "turretMountCount"
      ],
      "additionalProperties": false,
      "properties": {
        "baseHullHp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lanesY": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "lane centres as a fraction of screen height"
        },
        "turretMountCount": {
          "type": "integer",
          "minimum": 0
        },
        "bobAmplitude": {
          "type": "number",
          "minimum": 0,
          "description": "idle torso bob, px"
        },
        "bobPeriod": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds per bob cycle"
        },
        "swayAmplitude": {
          "type": "number",
          "minimum": 0,
          "description": "idle torso sway, degrees"
        },
        "swayPeriod": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds per sway cycle"
        },
        "turretMountOffsets": {
          "type": "array",
          "description": "turret mount positions relative to the torso, [x, y] pairs; mount 0 is the Phase 2 mount",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "world": {
      "type": "object",
      "required": [
        "baseWidth",
        "baseHeight",
        "mechaXFraction",
        "spawnXFraction",
        "despawnXFraction",
        "meleeStandoff",
        "projectileRadius",
        "projectileLifetime",
        "parallax",
        "maxFrameSeconds",
        "burrowSpawnXFraction",
        "flyingYOffset"
      ],
      "additionalProperties": false,
      "properties": {
        "baseWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "baseHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mechaXFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spawnXFraction": {
          "type": "number",
          "description": "enemy spawn x as a fraction of width, above 1 is off screen right"
        },
        "despawnXFraction": {
          "type": "number",
          "description": "x fraction past which a projectile is recycled"
        },
        "meleeStandoff": {
          "type": "number",
          "minimum": 0,
          "description": "px from the mecha centre where melee enemies stop and attack"
        },
        "projectileRadius": {
          "type": "number",
          "minimum": 0,
          "description": "collision radius of a shell, added to the target radius"
        },
        "projectileLifetime": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "seconds before an unspent shell is recycled"
        },
        "parallax": {
          "type": "object",
          "required": [
            "sky",
            "ruins",
            "ground"
          ],
          "additionalProperties": false,
          "description": "scroll speed factors applied to the level scrollSpeed",
          "properties": {
            "sky": {
              "type": "number",
              "minimum": 0
            },
            "ruins": {
              "type": "number",
              "minimum": 0
            },
            "ground": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "maxFrameSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "largest delta a single frame may apply, so a backgrounded tab does not teleport the wave"
        },
        "burrowSpawnXFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "where burrow behaviour enemies erupt, as a fraction of width"
        },
        "flyingYOffset": {
          "type": "number",
          "minimum": 0,
          "description": "px a flying enemy sits above its lane"
        }
      }
    },
    "inBattleUpgrades": {
      "type": "object",
      "required": [
        "damage",
        "fireRate",
        "repair"
      ],
      "additionalProperties": false,
      "properties": {
        "damage": {
          "$ref": "#/definitions/upgradeTrack"
        },
        "fireRate": {
          "$ref": "#/definitions/upgradeTrack"
        },
        "repair": {
          "$ref": "#/definitions/upgradeTrack"
        }
      }
    },
    "vfx": {
      "type": "object",
      "required": [
        "maxParticlesDesktop",
        "maxParticlesMobile",
        "shakeMaxIntensity",
        "damageNumberPoolSize"
      ],
      "additionalProperties": false,
      "properties": {
        "maxParticlesDesktop": {
          "type": "integer",
          "minimum": 0
        },
        "maxParticlesMobile": {
          "type": "integer",
          "minimum": 0
        },
        "shakeMaxIntensity": {
          "type": "number",
          "minimum": 0
        },
        "damageNumberPoolSize": {
          "type": "integer",
          "minimum": 0
        },
        "scrapPickupRiseSpeed": {
          "type": "number",
          "minimum": 0
        },
        "scrapPickupLifetime": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hitFlashDuration": {
          "type": "number",
          "minimum": 0,
          "description": "seconds a damaged enemy stays tinted"
        },
        "hitFlashTint": {
          "type": "integer",
          "minimum": 0,
          "description": "tint colour applied on hit"
        },
        "damageNumberRise": {
          "type": "number",
          "minimum": 0,
          "description": "px a damage number floats upward per second"
        },
        "damageNumberLifetime": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "muzzleFlashDuration": {
          "type": "number",
          "minimum": 0
        },
        "shakePerDamage": {
          "type": "number",
          "minimum": 0,
          "description": "camera shake intensity per point of damage taken, clamped by shakeMaxIntensity"
        },
        "shakeDurationMs": {
          "type": "number",
          "minimum": 0
        },
        "impactParticleCount": {
          "type": "integer",
          "minimum": 0
        },
        "deathParticleCount": {
          "type": "integer",
          "minimum": 0
        },
        "exhaustSmokeFrequency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "ms between exhaust smoke puffs"
        },
        "cannonRecoilPixels": {
          "type": "number",
          "minimum": 0,
          "description": "px the main cannon kicks back on firing"
        },
        "turretRecoilPixels": {
          "type": "number",
          "minimum": 0
        },
        "recoilRecovery": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "how fast recoil decays back to rest, per second"
        },
        "muzzleFlashPoolSize": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pools": {
      "type": "object",
      "required": [
        "projectiles",
        "enemies"
      ],
      "additionalProperties": false,
      "properties": {
        "projectiles": {
          "type": "integer",
          "minimum": 1
        },
        "enemies": {
          "type": "integer",
          "minimum": 1
        },
        "scrapPickups": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "targeting": {
      "type": "object",
      "required": [
        "priorityOrder",
        "manualShotDamageMultiplier",
        "autoFireResumeDelay"
      ],
      "additionalProperties": false,
      "properties": {
        "priorityOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "focus",
              "ranged_in_range",
              "closest"
            ]
          }
        },
        "manualShotDamageMultiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "autoFireResumeDelay": {
          "type": "number",
          "minimum": 0,
          "description": "seconds of auto fire pause after a manual shot"
        },
        "manualDragThreshold": {
          "type": "number",
          "minimum": 0,
          "description": "px of pointer travel that turns a tap into a manual aim drag"
        },
        "touchDragOriginMinYFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "touch drags must start below this fraction of screen height so fingers do not cover the action"
        },
        "touchAimOffsetY": {
          "type": "number",
          "minimum": 0,
          "description": "px the touch aim point sits above the finger so it never covers the target"
        }
      }
    },
    "boss": {
      "type": "object",
      "description": "shared boss phase behaviour; per boss stats stay in enemies.json",
      "required": [
        "default",
        "byId"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "required": [
            "phase2HpFraction",
            "chargeSpeedMultiplier",
            "chargeDuration",
            "chargeCooldown"
          ],
          "additionalProperties": false,
          "properties": {
            "phase2HpFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "chargeSpeedMultiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "chargeDuration": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "chargeCooldown": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "entranceShakeIntensity": {
              "type": "number",
              "minimum": 0
            },
            "slamShakeIntensity": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "byId": {
          "type": "object",
          "description": "keyed by the boss enemy id in enemies.json",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "charger",
                  "shield_cycler",
                  "enrager"
                ]
              },
              "shieldUpDuration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "ventDuration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "enrageThresholds": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "enrageSpeedBonus": {
                "type": "number",
                "minimum": 0
              },
              "enrageDamageBonus": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "masterVolume",
        "sfxVolume",
        "musicVolume"
      ],
      "additionalProperties": false,
      "properties": {
        "masterVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sfxVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "musicVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "combat": {
      "type": "object",
      "required": [
        "shieldNonPiercingFactor"
      ],
      "additionalProperties": false,
      "properties": {
        "shieldNonPiercingFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "GAME_DESIGN section 6: only piercing damages a shield pool at full value"
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Hangar economy. Weapon and pilot stat tracks stay in weapons.json and pilots.json.",
      "required": [
        "startingWeapons",
        "weaponUnlockCosts",
        "turretMountCosts",
        "hullUpgrade"
      ],
      "additionalProperties": false,
      "properties": {
        "startingWeapons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "owned on a fresh save"
        },
        "weaponUnlockCosts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "cores to unlock, keyed by weapon id"
        },
        "turretMountCosts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "cores for mounts 2 and 3; mount 1 is free"
        },
        "hullUpgrade": {
          "type": "object",
          "required": [
            "costs",
            "bonusPerLevel"
          ],
          "additionalProperties": false,
          "properties": {
            "costs": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "bonusPerLevel": {
              "type": "number",
              "minimum": 0,
              "description": "additive hull fraction per level"
            }
          }
        }
      }
    },
    "tutorial": {
      "type": "object",
      "description": "Phase 4 tutorial hints. Shown only on the named level.",
      "required": [
        "levelId",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "levelId": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "duration",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0,
                "description": "seconds from battle start"
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
