                }
              }
            },
            "shielded": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "length",
                "width",
                "height"
              ],
              "properties": {
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0,
