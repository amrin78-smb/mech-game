{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enemy.schema.json",
  "title": "EnemyDef",
  "type": "object",
  "required": ["id", "name", "armorClass", "hp", "speed", "damage", "attackInterval", "reward", "spriteKey", "scale", "behaviors"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string" },
    "armorClass": { "enum": ["light", "armored", "shielded", "swarm"] },
    "hp": { "type": "number", "exclusiveMinimum": 0 },
    "shieldHp": { "type": "number", "minimum": 0, "description": "Separate pool, only meaningful with the shielded behavior" },
    "speed": { "type": "number", "minimum": 0, "description": "px per second at 1x world scale; 0 for anchored parts, which are carried rather than walking" },
    "damage": { "type": "number", "minimum": 0 },
    "attackRange": { "type": "number", "minimum": 0, "description": "0 or absent means melee contact range" },
    "attackInterval": { "type": "number", "exclusiveMinimum": 0, "description": "seconds between attacks" },
    "reward": { "type": "integer", "minimum": 0, "description": "scrap dropped on death" },
    "spriteKey": { "type": "string" },
    "scale": { "type": "number", "exclusiveMinimum": 0 },
    "flying": { "type": "boolean", "default": false },
    "behaviors": {
      "type": "array",
      "items": { "enum": ["melee", "ranged", "burrow", "spawner", "shielded", "barrier", "burner", "anchored"] },
      "uniqueItems": true
    },
    "weakPoints": {
      "type": "object",
      "description": "Destructible parts carried on this enemy's body, each a targetable enemy of its own",
      "required": ["enemyId", "mounts", "bodyDamageFactor"],
      "additionalProperties": false,
      "properties": {
        "enemyId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "description": "Offsets as fractions of the carrier's display size, so art swaps keep them on the hull",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "bodyDamageFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Share of incoming damage the body takes while any part still lives"
        }
      }
    },
    "burnZone": {
      "type": "object",
      "description": "The burner behavior: an attack reaching the hull leaves burning ground rather than biting once",
      "required": ["damagePerSecond", "duration", "radius", "spreadX", "offsetX"],
      "additionalProperties": false,
      "properties": {
        "damagePerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "seconds the patch burns" },
        "radius": { "type": "number", "exclusiveMinimum": 0, "description": "screen px" },
        "spreadX": { "type": "number", "minimum": 0, "description": "px either side of the aim point that repeat arcs scatter across" },
        "offsetX": { "type": "number", "minimum": 0, "description": "px in front of the mecha the arc lands" }
      }
    },
    "barrier": {
      "type": "object",
      "description": "The barrier behavior: a frontal screen that intercepts shots aimed at anything behind it while the shield pool holds",
      "required": ["radius", "offsetX"],
      "additionalProperties": false,
      "properties": {
        "radius": { "type": "number", "exclusiveMinimum": 0, "description": "screen px" },
        "offsetX": { "type": "number", "minimum": 0, "description": "px in front of the enemy, toward the mecha" }
      }
    },
    "spawns": {
      "type": "object",
      "description": "Only for the spawner behavior",
      "required": ["enemyId", "count", "interval"],
      "additionalProperties": false,
      "properties": {
        "enemyId": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "interval": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
